#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    macros {
        ctrlbc: ctrlbc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp C>;
            label = "CTRLBC";
        };

        ctrlbbr: ctrlbbr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp LEFT_BRACKET>;
            label = "CTRLBBR";
        };

        ctrlbx: ctrlbx {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp X>;
            label = "CTRLBX";
        };

        ctrlbn: ctrlbn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp N>;
            label = "CTRLBN";
        };

        ctrlbp: ctrlbp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp P>;
            label = "CTRLBP";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp GRAVE         &kp N1   &kp N2        &kp N3         &kp N4           &kp N5     &kp N6           &kp N7                 &kp N8       &kp N9               &kp N0    &kp MINUS
  &kp TAB           &kp Q    &kp W         &kp E          &kp R            &kp T      &kp Y            &kp U                  &kp I        &kp O                &kp P     &kp LBKT
  &kp ESC           &kp A    &kp S         &kp D          &kp F            &kp G      &kp H            &kp J                  &kp K        &kp L                &kp SEMI  &kp SINGLE_QUOTE
  &kp LEFT_CONTROL  &lt 3 Z  &kp X         &kp C          &kp V            &kp B      &kp N            &kp M                  &kp COMMA    &kp DOT              &kp FSLH  &mt RIGHT_SHIFT BACKSLASH
                             &kp LEFT_ALT  &kp LEFT_META  &mt LSHFT SPACE  &kp RET    &lt 2 BACKSPACE  &mt RIGHT_SHIFT SPACE  &lt 1 EQUAL  &lt 2 RIGHT_BRACKET
            >;
        };

        raise_layer {
            bindings = <
  &kp F12    &kp F1         &kp F2        &kp F3        &kp F4          &kp F5       &kp F6    &kp F7                &kp F8                 &kp F9           &kp F10  &kp F11
  &none      &none          &none         &none         &none           &none        &kp HOME  &kp PAGE_DOWN         &kp PAGE_UP            &kp END          &ctrlbp  &ctrlbbr
  &none      &none          &none         &none         &none           &none        &kp LEFT  &kp DOWN              &kp UP                 &kp RIGHT        &none    &none
  &kp LCTRL  &kp LA(LG(Z))  &ctrlbx       &ctrlbc       &none           &kp LC(B)    &ctrlbn   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none            &none    &none
                            &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT  &kp ENTER    &none     &none                 &none                  &lt 3 LA(SPACE)
            >;
        };

        lower_layer {
            bindings = <
  &none  &none  &none  &none  &none  &none    &none          &none  &none            &none    &kp C_VOLUME_DOWN     &kp C_VOLUME_UP
  &none  &none  &none  &none  &none  &none    &none          &none  &none            &none    &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC
  &none  &none  &none  &none  &none  &none    &kp BACKSPACE  &none  &none            &kp DEL  &none                 &none
  &none  &none  &none  &none  &none  &none    &none          &none  &none            &none    &none                 &none
                &none  &none  &none  &none    &none          &none  &lt 3 LA(SPACE)  &none
            >;
        };

        adjust_layer {
            bindings = <
  &none       &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &none
  &none       &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &none
  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
  &sys_reset  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &none
                            &none         &none         &none         &none           &none         &none         &none         &none
            >;
        };
    };
};
